{
	"firestore": {
		"rules": "firestore.rules"
	},
	"emulators": {
		"auth": {
			"port": 9199
		},
		"firestore": {
			"port": 8180
		},
		"ui": {
			"enabled": true
		}
	},
	"hosting": {
		"public": "dist",
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	}
}